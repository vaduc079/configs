font-family = CaskaydiaCove Nerd Font Mono
font-size = 13

theme = Gruvbox Dark

macos-titlebar-style = tabs
macos-option-as-alt = true
confirm-close-surface = false

focus-follows-mouse = true
mouse-shift-capture = false
mouse-hide-while-typing = true

window-padding-x = 1
window-padding-y = 0

background-opacity = 0.98
background-blur = 30
unfocused-split-opacity = 1

shell-integration = detect
shell-integration-features = no-cursor,title


cursor-style = block
cursor-style-blink = false

scrollback-limit = 5000000

tab-inherit-working-directory = true
split-inherit-working-directory = true

config-file = keybinds/default.ghostty
# The Herdr wrapper creates this temporary override while Herdr is running.
config-file = ?keybinds/active.ghostty
