{
  // pi's packages are linked into node_modules by `npm run link-pi` (scripts/link-pi.ts).
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    // pi loads the .ts files as they are, and tests run them with Node's type stripping:
    // only erasable syntax, and type-only imports must say `import type`.
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    // pi's loader maps `@earendil-works/pi-ai` to this view for extensions (dist/core/extensions/loader.js);
    // its StringEnum is a TypeBox schema, so tool params infer their real types.
    "paths": {
      "@earendil-works/pi-ai": ["./node_modules/@earendil-works/pi-coding-agent/dist/core/extensions/pi-ai-extension-view.d.ts"]
    },
    "types": ["node"]
  },
  "include": ["extensions", "src", "scripts", "lint"]
}
