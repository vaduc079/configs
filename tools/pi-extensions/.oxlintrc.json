{
  // Rules and the disable policy: AGENTS.md "Code".
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "jsPlugins": ["./lint/plugin.ts"],
  "categories": { "correctness": "error" },
  "options": { "typeAware": true, "reportUnusedDisableDirectives": "error", "respectEslintDisableDirectives": false },
  "env": { "node": true, "es2024": true },
  "ignorePatterns": ["node_modules/"],
  "rules": {
    // Structure: extensions import their own folder, src/, and packages; src/ never imports an extension.
    "local/boundaries": "error",
    "local/disable-reason": "error",

    // Validate once at the boundary; do not re-check what the types already guarantee.
    "typescript/no-unnecessary-condition": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-unnecessary-type-arguments": "error",
    // No `any`; rely on inference.
    "typescript/no-explicit-any": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/no-inferrable-types": "error",
    // Promises and `this` mistakes.
    "typescript/no-floating-promises": "error",
    "typescript/unbound-method": "error",
    "typescript/restrict-template-expressions": "error",
    "typescript/no-base-to-string": "error",
    // Dead code.
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_", "caughtErrors": "none" }],
    "no-unused-private-class-members": "error",
    "no-useless-return": "error",

    // Early returns over nesting; keep the happy path obvious.
    "no-else-return": ["error", { "allowElseIf": false }],
    "no-lonely-if": "error",
    "max-depth": ["error", 3],

    // Smallest feature set that reads well.
    "local/no-extends": "error",
    "prefer-const": "error",
    "no-var": "error",
    "eqeqeq": ["error", "always", { "null": "ignore" }],
    "preserve-caught-error": "error"
  },
  "overrides": [
    {
      // node:test runs every test() it is handed; tests fake pi's API with partial objects.
      "files": ["**/*.test.ts"],
      "rules": {
        "typescript/no-floating-promises": "off",
        "typescript/no-non-null-assertion": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-argument": "off"
      }
    },
    {
      // Vendored from OpenCode: keep upstream's shape so it can be diffed and updated. Boundaries still apply.
      "files": ["extensions/permissions/shell/scan.ts"],
      "rules": {
        "max-depth": "off",
        "typescript/no-unnecessary-condition": "off"
      }
    }
  ]
}
