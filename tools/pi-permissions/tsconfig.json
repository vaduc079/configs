{
  // Types come from the installed pi release, linked as ./pi_modules by `npm run link-pi`,
  // so they always match the pi version that loads this extension.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "@earendil-works/*": ["./pi_modules/@earendil-works/*"]
    },
    "typeRoots": ["./pi_modules/@types"],
    "types": ["node"]
  },
  "include": ["*.ts", "shell/*.ts"]
}
