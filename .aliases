#!/bin/sh

# eza, better ls
alias ls='eza'
alias ll='eza --icons --group-directories-first --color always -lahog'

alias load_zshrc='source ~/.zshrc'

# short alias
alias lzg='lazygit'
alias lzd='lazydocker'
alias herdr='$HOME/.config/zsh/scripts/herdr-with-ghostty-keybinds.sh'

# vim
alias vim='nvim'
alias vi='nvim'

# set env var
alias codex-personal='CODEX_HOME=~/.codex-personal codex'
